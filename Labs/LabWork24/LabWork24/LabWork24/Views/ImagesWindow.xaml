<Window x:Class="LabWork24.Views.ImagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork24.Views"
        mc:Ignorable="d"
        Title="ImagesWindow" WindowState="Maximized" Background="Black"
        WindowStyle="None" KeyDown="Window_KeyDown" MouseMove="Window_MouseMove">
    <StackPanel>
        <Image Source="{Binding Picture}" Stretch="Fill"/>
    </StackPanel>
</Window>
