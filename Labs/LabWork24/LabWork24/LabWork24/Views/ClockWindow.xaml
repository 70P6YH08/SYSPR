<Window x:Class="LabWork24.Views.ClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork24.Views"
        mc:Ignorable="d"
        Title="ClockWindow" WindowStyle="None" WindowState="Maximized" Background="Black"
        KeyDown="Window_KeyDown"  MouseMove="Window_MouseMove" x:Name="ClocksWindow">
    <Canvas x:Name="ClockCanvas" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label x:Name="ClockLabel" Background="BlueViolet" Content="{Binding ClockTime}" Foreground="Beige" FontSize="40" FontWeight="Bold" />
    </Canvas>
</Window>
