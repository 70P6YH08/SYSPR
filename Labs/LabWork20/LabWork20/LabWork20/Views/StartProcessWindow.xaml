<Window x:Class="LabWork20.Views.StartProcessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork20.Views"
        mc:Ignorable="d"
        Title="StartProcessWindow" Height="450" Width="800">
    <StackPanel Width="300">
        <TextBlock Text="Имя исполняемого файла: " Margin="5"/>
        <TextBox Text="{Binding ProcessName}" Margin="5"/>
        <Button Content="Ok" Command="{Binding StartProcessCommand}" Width="150" Margin="5"/>
        <Button Content="Обзор" Command="{Binding SelectProcessCommand}" Width="150" Margin="5"/>
        <Button x:Name="CloseWindow" Content="Отмена" Width="150" Click="CloseWindow_Click" Margin="5"/>
    </StackPanel>
</Window>
