<Window x:Class="LabWork20.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork20"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel MaxWidth="1200">
        <Menu>
            <MenuItem x:Name="NewWindowMenuItem" Header="Запустить новую задачу" Click="NewWindowMenuItem_Click"/>
            <MenuItem Header="Снять задачу"/>
            <MenuItem x:Name="ExitMenuItem" Header="Выход" Click="ExitMenuItem_Click"/>
        </Menu>
        <DockPanel>
            <TextBlock Text="Количество запущенных процессов: "/>
            <TextBlock Text="{Binding CountProcess}"/>
        </DockPanel>
        <TabControl Height="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}, Path=ActualHeight}">
            <TabItem Header="Процесы">
                <DataGrid ItemsSource="{Binding Processes}" Margin="3"
                          ScrollViewer.VerticalScrollBarVisibility="Visible" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Path=Id}" Width="100" Header="Id"/>
                        <DataGridTextColumn Binding="{Binding Path=Name}" Width="200" Header="Имя"/>
                        <DataGridTextColumn Binding="{Binding Path=Memory}" Width="200" Header="Память"/>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Снять задачу" Command="{Binding KillProcessByIdCommand}"
                                        CommandParameter="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ContextMenu}}, Path=PlacementTarget.SelectedItem}"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>
            <TabItem Header="Приложения">
                <StackPanel>
                    <Button x:Name="UpdateAppsButton" Content="Обновить" HorizontalAlignment="Right" Command="{Binding GetApplicationListWithMWTCommand}" CommandParameter="{Binding}"/>
                    <DataGrid ItemsSource="{Binding Applications}" Margin="3"
                          ScrollViewer.VerticalScrollBarVisibility="Visible" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Path=Title}" Width="300" Header="Приложение"/>
                            <DataGridTextColumn Binding="{Binding Path=StartTime, StringFormat='dd/MM/yyyy hh:mm:ss'}" Width="300" Header="Время запуска"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Снять задачу"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </StackPanel>
            </TabItem>
        </TabControl>
    </StackPanel>
</Window>
