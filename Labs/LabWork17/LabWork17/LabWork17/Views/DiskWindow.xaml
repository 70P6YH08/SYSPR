<Window x:Class="LabWork17.Views.DiskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork17.Views"
        mc:Ignorable="d"
        Title="DiskWindow" Height="300" Width="400">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
        <Border BorderBrush="Gray">
            <Border.BorderThickness>
                <Thickness Bottom="1"/>
            </Border.BorderThickness>
            <DockPanel Margin="2" Background="AliceBlue">
                <Image Source="{Binding SelectedDisk.IconPath}" Height="30" Width="30" Margin="0 0 40 0"/>
                <TextBox Text="{Binding SelectedDisk.Name}" VerticalAlignment="Center" Width="Auto" BorderBrush="LightBlue">
                    <TextBox.BorderThickness>
                        <Thickness Bottom="2"/>
                    </TextBox.BorderThickness>
                </TextBox>
            </DockPanel>
        </Border>

        <Border BorderBrush="Gray">
            <Border.BorderThickness>
                <Thickness Bottom="1"/>
            </Border.BorderThickness>
            <DockPanel Margin="2" Background="AliceBlue">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Тип:"/>
                    <TextBlock Text="Файловая система:" Grid.Row="1"/>
                    <TextBox Text="{Binding SelectedDisk.DiskType}" VerticalAlignment="Center" Width="Auto" Grid.Column="1" Background="AliceBlue" BorderThickness="0"/>
                    <TextBox Text="{Binding SelectedDisk.DiskFileSystem}" VerticalAlignment="Center" Width="Auto" Grid.Column="1" Grid.Row="1" Background="AliceBlue" BorderThickness="0"/>
                </Grid>
            </DockPanel>
        </Border>
        <Border BorderBrush="Gray">
            <Border.BorderThickness>
                <Thickness Bottom="1"/>
            </Border.BorderThickness>
            <DockPanel Margin="2" Background="AliceBlue">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Height="15" Width="15" Fill="LightBlue"/>
                    <Rectangle Height="15" Width="15" Fill="DarkGray" Grid.Row="1"/>
                    <TextBlock Text="Занято:" Grid.Column="1"/>
                    <TextBlock Text="Свободно:" Grid.Row="1" Grid.Column="1"/>
                    <TextBox Text="{Binding SelectedDisk.DiskOccupiedSizeBytes}" VerticalAlignment="Center" Width="Auto" Grid.Column="2" Background="AliceBlue" BorderThickness="0"/>
                    <TextBox Text="{Binding SelectedDisk.DiskAvailableSizeBytes}" VerticalAlignment="Center" Width="Auto" Grid.Column="2" Grid.Row="1" Background="AliceBlue" BorderThickness="0"/>
                    <TextBox Text="{Binding SelectedDisk.DiskOccupiedSizeText}" VerticalAlignment="Center" Width="Auto" Grid.Column="3" Background="AliceBlue" BorderThickness="0"/>
                    <TextBox Text="{Binding SelectedDisk.DiskAvailableSize}" VerticalAlignment="Center" Width="Auto" Grid.Column="3" Grid.Row="1" Background="AliceBlue" BorderThickness="0"/>
                </Grid>
            </DockPanel>
        </Border>
        <DockPanel Margin="2" Background="AliceBlue" Height="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="5*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ёмкость:" Grid.Column="1"/>
                <TextBox Text="{Binding SelectedDisk.DiskTotalSizeTextBytes}" VerticalAlignment="Center" Width="Auto" Grid.Column="2" Background="AliceBlue" BorderThickness="0"/>
                <TextBox Text="{Binding SelectedDisk.DiskTotalSizeText}" VerticalAlignment="Center" Width="Auto" Grid.Column="3" Background="AliceBlue" BorderThickness="0"/>
            </Grid>
        </DockPanel>

    </StackPanel>
</Window>
