<Window x:Class="LabWork17.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork17"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <ContextMenu x:Key="FilesContextMenu">
            <MenuItem x:Name="CopyFileMenuItem" Header="Копировать" Click="CopyFileMenuItem_Click"/>
            <MenuItem x:Name="PasteFileMenuItem" Header="Вставить" Click="PasteFileMenuItem_Click"/>
            <MenuItem x:Name="CompressFolderMenuItem" Header="Сжать в архив" Click="CompressFolderMenuItem_Click"/>
            <MenuItem x:Name="ArchiveExtractMenuItem" Header="Извлечь из архива" Click="ArchiveExtractMenuItem_Click"/>
            <MenuItem x:Name="PropertiesMenuItem" Header="Свойства" Visibility="{Binding IsProperiesMenuVisible}"
                      Command="{Binding OpenDiskPropertiesCommand}"
                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
        </ContextMenu>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл"/>
            <MenuItem Header="Правка"/>
            <MenuItem Header="Вид"/>
            <MenuItem Header="Справка"/>
        </Menu>

        <StackPanel DockPanel.Dock="Top" Margin="5">
            <TextBlock Text="Имя каталога" Margin="2"/>
            <TextBox x:Name="DirPathTextBox" Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}" Margin="2" KeyDown="DirPathTextBox_KeyDown"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel DockPanel.Dock="Top">
                <DataGrid Name="FilesDataGrid"
          ItemsSource="{Binding Files}"
          AutoGenerateColumns="False"
          MouseDoubleClick="OpenFolder_MouseDoubleClick"
          Visibility="{Binding IsVisibleFiles}"
          ContextMenu="{StaticResource FilesContextMenu}"
                          SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn x:Name="IconDataGridTemplateColumn" Header="Иконка" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding IconPath}" Width="40" Height="40"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding Name}" Header="Имя" Width="200"/>
                        <DataGridTextColumn Binding="{Binding ChangedTime}" Header="Дата изменения" Width="150"/>
                        <DataGridTextColumn Binding="{Binding Weight}" Header="Вес файла" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
                <DataGrid Name="DisksDataGrid"
          ItemsSource="{Binding Disks}"
          AutoGenerateColumns="False"
          MouseDoubleClick="OpenFolder_MouseDoubleClick"
          Visibility="{Binding IsVisibleDisks}"
          ContextMenu="{StaticResource FilesContextMenu}"
                          SelectedItem="{Binding SelectedItem}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding DiskLetter}" Header="Метка тома" Width="100"/>
                        <DataGridTextColumn Binding="{Binding Name}" Header="Имя" Width="200"/>
                        <DataGridTextColumn Binding="{Binding DiskTotalSizeText}" Header="Общий размер" Width="200"/>
                        <DataGridTemplateColumn Header="Занятое пространство" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding DiskOccupiedSize}" Maximum="{Binding DiskTotalSize}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Binding="{Binding DiskAvailableSize}" Header="Свободно" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>